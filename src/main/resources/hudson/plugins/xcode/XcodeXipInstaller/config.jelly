<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Download URL} (.xip)" field="url">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Subdirectory within archive}" field="subdir">
        <f:textbox default="Xcode.app/Contents/Developer" />
    </f:entry>
    <f:entry title="${%Label}" field="label">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Run first-launch tasks via passwordless sudo}" field="runFirstLaunch">
        <f:checkbox />
    </f:entry>
</j:jelly>
